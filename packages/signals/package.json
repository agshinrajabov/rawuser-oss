{
  "name": "@rawuser/signals",
  "version": "0.1.0",
  "description": "Where a visit came from: AI assistants, in-app browsers, ad click ids, tagged links and referrers, read from one request. No cookie, no identifier.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/signals/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/types/signals/src/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": [
    "traffic source",
    "referrer",
    "utm",
    "ai traffic",
    "chatgpt",
    "in-app browser",
    "click id",
    "attribution",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agshinrajabov/rawuser-oss.git",
    "directory": "packages/signals"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --import tsx/esm build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node --import tsx/esm build.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
