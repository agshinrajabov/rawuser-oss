{
  "name": "@rawuser/intent",
  "version": "0.1.0",
  "description": "From a visit's signals to why the visitor came: a vector over intents, sources and contexts, and the strongest pair. Pure functions, nothing about who the visitor is.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/intent/src/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/types/intent/src/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": [
    "intent",
    "personalization",
    "traffic source",
    "utm",
    "ai traffic",
    "classifier",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agshinrajabov/rawuser-oss.git",
    "directory": "packages/intent"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node --import tsx/esm build.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "node --import tsx/esm build.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
