# Rawuser on your own server. Copy to `.env` at the repository's root and
# fill in, or run `pnpm server:setup`, which asks and writes it for you.

# The three public addresses. Each needs its own host or port: the tag on
# your site calls the first, the dashboard calls the second.
EDGE_ORIGIN=http://localhost:8787
API_ORIGIN=http://localhost:8788
DASHBOARD_ORIGIN=http://localhost:8789

# The ports this process listens on, and the address it binds.
# EDGE_PORT=8787
# API_PORT=8788
# DASHBOARD_PORT=8789
# HOST=0.0.0.0

# Where the SQLite files are kept. Back this folder up.
# DATA_DIR=./data

# The model that writes your versions: any OpenAI-compatible endpoint.
MODEL_BASE_URL=https://your-model-endpoint.example.com/v1
MODEL_ID=the-model-that-writes
# MODEL_FALLBACK_ID=a-second-model-on-the-same-endpoint
MODEL_API_KEY=
# A reasoning model must have its reasoning turned off, in whatever form
# your provider takes, or the page read comes back empty:
# MODEL_EXTRA_BODY='{"thinking":{"type":"disabled"}}'
# A stronger model for reading the page's parts alone:
# MODEL_ID_DETECT=a-stronger-model

# Seals stored two-step secrets. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# and never change it afterwards.
MFA_ENCRYPTION_KEY=

# Behind your own reverse proxy: read the visitor's address from the last
# entry of X-Forwarded-For, the one your proxy added. Leave off when the
# ports are open to the internet, or a visitor could claim any address.
# TRUST_PROXY=on

# If your proxy sets a header with the visitor's country as two letters,
# overwriting whatever a client sent, name it. Unset, every visit's country is recorded as "other".
# COUNTRY_HEADER=CF-IPCountry

# Delete event rows after this many days (61 or more). Unset: kept until
# you delete a customer.
# RAW_EVENT_RETENTION_DAYS=90

# Every other setting is the same as in packages/generation/wrangler.toml
# and packages/edge/wrangler.toml: SENDER_NAME, OPERATOR_NAME,
# REMEMBER_DEFAULT, and the rest.
