{
  "name": "rawuser",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check packages scripts docs biome.json package.json tsconfig.base.json vitest.config.ts vitest.workspace.ts",
    "format": "biome format --write packages scripts docs biome.json package.json tsconfig.base.json vitest.config.ts vitest.workspace.ts",
    "dev:edge": "pnpm --filter @rawuser/edge dev",
    "dev:generation": "pnpm --filter @rawuser/generation dev",
    "dev:dashboard": "pnpm --filter @rawuser/dashboard dev",
    "build:snippet": "pnpm --filter @rawuser/snippet build",
    "build:snippet:inline": "pnpm build:snippet && tsx scripts/inline-snippet-to-edge.ts",
    "build:dashboard": "pnpm --filter @rawuser/dashboard build",
    "deploy:edge": "pnpm build:snippet:inline && pnpm --filter @rawuser/edge run deploy",
    "deploy:generation": "pnpm --filter @rawuser/generation run deploy",
    "db:migrate": "wrangler --config packages/generation/wrangler.toml d1 migrations apply rawuser_db --remote",
    "db:migrate:local": "wrangler --config packages/generation/wrangler.toml d1 migrations apply rawuser_db --local",
    "gen:create-superadmin": "tsx scripts/create-superadmin.ts",
    "self-host": "tsx scripts/self-host.ts",
    "server:setup": "tsx packages/server/src/cli-setup.ts",
    "server:start": "tsx packages/server/src/cli-build.ts && tsx packages/server/src/main.ts",
    "server:user": "tsx packages/server/src/cli-user.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^22.0.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
